---
import Base from '../layouts/Base.astro';
import Search from '../components/Search.astro';
import { loadData } from '../lib/load';
import { url } from '../lib/url';

const { needs, tools, toolsByNeed } = loadData();
const groups = [...new Set(needs.map((need) => need.group))];
---

<Base
  title="devtools — free developer tools, by what you need to do"
  description={`A curated index of ${tools.length} free developer tools, organised by task rather than by vendor category.`}
>
  <h1 class="text-3xl font-semibold tracking-tight">I need to…</h1>
  <p class="mt-3 text-neutral-600 dark:text-neutral-400">
    {tools.length} free developer tools, organised by what you are actually trying to do. Every
    entry has a note on why it is the pick, or what the catch is.
  </p>

  <Search />

  <div data-browse>
    {
      groups.map((group) => (
        <section class="mt-10">
          <h2 class="text-xs font-semibold tracking-wider text-neutral-400 uppercase">{group}</h2>
          <ul class="mt-3 divide-y divide-neutral-200 dark:divide-neutral-800">
            {needs
              .filter((need) => need.group === group)
              .map((need) => (
                <li class="py-2.5">
                  <a
                    href={url(`need/${need.slug}`)}
                    class="group flex items-baseline justify-between gap-4"
                  >
                    <span class="group-hover:underline">{need.question}</span>
                    <span class="shrink-0 text-sm text-neutral-400">
                      {toolsByNeed.get(need.slug)!.length}
                    </span>
                  </a>
                </li>
              ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
