---
import Base from '../../layouts/Base.astro';
import PricingBadge from '../../components/PricingBadge.astro';
import { loadData } from '../../lib/load';
import { verifiedAge, isStale } from '../../lib/verified';

// Only multi-need tools get a page. A single-need tool would render a near-duplicate of the need
// page it came from, and a swarm of those reads as doorway pages to search engines.
export async function getStaticPaths() {
  const { needs, tools } = loadData();
  const needBySlug = new Map(needs.map((need) => [need.slug, need]));

  return tools
    .filter((tool) => tool.needs.length >= 2)
    .map((tool) => ({
      params: { slug: tool.slug },
      props: { tool, needs: tool.needs.map((slug) => needBySlug.get(slug)!) },
    }));
}

const { tool, needs } = Astro.props;
const today = new Date().toISOString().slice(0, 10);
const base = import.meta.env.BASE_URL;
const stale = isStale(tool.verified, today);
---

<Base
  title={`What's free on ${tool.name}?`}
  description={`${tool.name} covers ${needs.length} developer needs on its free tier. ${tool.note}`}
>
  <a href={base} class="text-sm text-neutral-500 underline">← all needs</a>

  <h1 class="mt-4 flex flex-wrap items-center gap-3 text-3xl font-semibold tracking-tight">
    {tool.name}
    <PricingBadge pricing={tool.pricing} />
  </h1>

  <p class="mt-3 text-neutral-600 dark:text-neutral-400">{tool.note}</p>
  <a href={tool.url} rel="noopener" class="mt-2 inline-block text-sm underline">{tool.url}</a>

  <h2 class="mt-10 text-xs font-semibold tracking-wider text-neutral-400 uppercase">
    Use it when you need to
  </h2>
  <ul class="mt-3 divide-y divide-neutral-200 dark:divide-neutral-800">
    {
      needs.map((need) => (
        <li class="py-2.5">
          <a href={`${base}/need/${need.slug}`} class="underline">
            {need.question}
          </a>
        </li>
      ))
    }
  </ul>

  <p class="mt-10 text-xs text-neutral-400">
    {stale ? `unverified since ${tool.verified}` : `verified ${verifiedAge(tool.verified, today)}`}
  </p>
</Base>
