---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import { loadData } from '../../lib/load';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const { needs, toolsByNeed } = loadData();
  return needs.map((need) => ({
    params: { slug: need.slug },
    props: { need, tools: toolsByNeed.get(need.slug)! },
  }));
}

const { need, tools } = Astro.props;
const today = new Date().toISOString().slice(0, 10);
const task = need.question.replace(/^I need to /, '');
---

<Base
  title={`${need.h1} — free tools`}
  description={`${tools.length} free tools for when you need to ${task}. Curated, each with a note on the catch.`}
>
  <a href={url()} class="text-sm text-neutral-500 underline">← all needs</a>
  <h1 class="mt-4 text-3xl font-semibold tracking-tight">{need.h1}</h1>
  <p class="mt-2 text-neutral-500">{need.question}</p>

  <ul class="mt-8">
    {tools.map((tool) => <ToolCard tool={tool} today={today} />)}
  </ul>
</Base>
