---
// Hidden until the script runs, so a visitor without JS gets the full browsable list rather than a
// search box that does nothing.
---

<div class="mt-6" data-search hidden>
  <div class="relative">
    <input
      type="search"
      placeholder="Search needs and tools…"
      aria-label="Search needs and tools"
      class="w-full rounded-lg border border-neutral-300 py-2.5 pr-20 pl-3.5 text-sm dark:border-neutral-700 dark:bg-neutral-900"
      data-search-input
    />
    <!-- Populated by the script: the modifier key depends on the visitor's OS, which static HTML
         cannot know. Stays empty (and so invisible) if the script never runs. -->
    <kbd
      class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 rounded border border-neutral-200 bg-neutral-100 px-1.5 py-1 font-sans text-[11px] leading-none tracking-[0.08em] text-neutral-400 dark:border-neutral-700 dark:bg-neutral-800"
      aria-hidden="true"
      data-search-hint></kbd>
  </div>
  <ul class="mt-3 hidden divide-y divide-neutral-200 dark:divide-neutral-800" data-search-results>
  </ul>
</div>

<script>
  import Fuse from 'fuse.js';
  import { url } from '../lib/url';

  const root = document.querySelector<HTMLElement>('[data-search]')!;
  const input = root.querySelector<HTMLInputElement>('[data-search-input]')!;
  const hint = root.querySelector<HTMLElement>('[data-search-hint]')!;
  const results = root.querySelector<HTMLUListElement>('[data-search-results]')!;
  const browse = document.querySelector<HTMLElement>('[data-browse]');

  root.hidden = false;

  const isMac = /Mac|iPhone|iPad|iPod/.test(navigator.userAgent);
  hint.textContent = isMac ? '⌘K' : 'Ctrl K';

  const entries = await fetch(url('search.json')).then((res) => res.json());
  // ignoreLocation is load-bearing: by default Fuse only matches near the start of a field, so
  // aliases sitting late in `terms` never match — "ngrok alternative" returned nothing without it.
  const fuse = new Fuse(entries, {
    keys: ['title', 'subtitle', 'terms'],
    threshold: 0.35,
    ignoreLocation: true,
  });

  const escape = (value: string) =>
    value.replace(
      /[&<>"']/g,
      (char) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char] ?? char,
    );

  const render = () => {
    const query = input.value.trim();
    const hasQuery = query.length > 1;

    results.classList.toggle('hidden', !hasQuery);
    browse?.classList.toggle('hidden', hasQuery);
    // The shortcut hint is only useful before you engage with the field.
    hint.hidden = input.value.length > 0;

    if (!hasQuery) {
      results.innerHTML = '';
      return;
    }

    results.innerHTML = fuse
      .search(query)
      .slice(0, 12)
      .map(({ item }: any) => {
        // Tool hits leave the site, so they open alongside the index rather than replacing it.
        const target = item.external ? ' target="_blank" rel="noopener"' : '';
        return (
          `<li class="py-2.5"><a href="${escape(item.href)}"${target} class="underline">${escape(item.title)}</a>` +
          `<span class="ml-2 text-sm text-neutral-400">${escape(item.subtitle)}</span></li>`
        );
      })
      .join('');
  };

  input.addEventListener('input', render);

  document.addEventListener('keydown', (event) => {
    const wantsSearch = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k';
    if (wantsSearch) {
      // Without preventDefault this hits the browser's own address-bar shortcut in Firefox.
      event.preventDefault();
      input.focus();
      input.select();
      return;
    }

    if (event.key === 'Escape' && document.activeElement === input) {
      input.value = '';
      render();
      input.blur();
    }
  });
</script>
