---
import type { Tool } from '../schema';
import { url } from '../lib/url';
import PricingBadge from './PricingBadge.astro';
import VerifiedLine from './VerifiedLine.astro';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const hasOwnPage = tool.needs.length >= 2;
---

<li class="border-b border-neutral-200 py-4 last:border-0 dark:border-neutral-800">
  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
    <a
      href={tool.url}
      target="_blank"
      rel="noopener"
      class="font-medium underline decoration-neutral-300 hover:decoration-current dark:decoration-neutral-600"
    >
      {tool.name}
    </a>
    <PricingBadge pricing={tool.pricing} />
    {
      hasOwnPage && (
        <a href={url(`tool/${tool.slug}`)} class="text-xs text-neutral-500 underline">
          {tool.needs.length} uses
        </a>
      )
    }
  </div>
  <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">{tool.note}</p>
  <VerifiedLine verified={tool.verified} class="mt-1 text-xs text-neutral-400" />
</li>
